{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "$ref": "#/$defs/image"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "workloadType": {
      "type": "string",
      "enum": [
        "Deployment",
        "StatefulSet",
        "DaemonSet",
        "Job",
        "CronJob"
      ]
    },
    "replicas": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "strategy": {
      "type": "object"
    },
    "restartPolicy": {
      "type": "string",
      "enum": [
        "Always",
        "OnFailure",
        "Never"
      ]
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env": {
      "$ref": "#/$defs/envMap"
    },
    "envFrom": {
      "$ref": "#/$defs/envFromList"
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/containerPort"
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "liveness": {
          "oneOf": [
            {
              "$ref": "#/$defs/probeConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "readiness": {
          "oneOf": [
            {
              "$ref": "#/$defs/probeConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "startup": {
          "oneOf": [
            {
              "$ref": "#/$defs/probeConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "securityContext": {
      "type": "object"
    },
    "lifecycle": {
      "type": "object"
    },
    "volumeMounts": {
      "type": "array"
    },
    "sidecars": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/container"
      }
    },
    "initContainers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/initContainer"
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterIssuer": {
          "type": "string"
        },
        "authentikOutpost": {
          "type": "string"
        }
      }
    },
    "routeType": {
      "type": "string",
      "enum": [
        "ingress",
        "gateway"
      ]
    },
    "gatewayName": {
      "type": "string"
    },
    "gatewayNamespace": {
      "type": "string"
    },
    "gatewaySectionName": {
      "type": "string"
    },
    "ingress": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hostname": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "pathType": {
            "type": "string"
          },
          "className": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "servicePort": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "certManager": {
            "type": "boolean"
          },
          "clusterIssuer": {
            "type": "string"
          },
          "externalDns": {
            "type": "boolean"
          },
          "authentik": {
            "type": "boolean"
          },
          "proxyBodySize": {
            "type": "string"
          },
          "annotations": {
            "type": "object"
          },
          "gatewayName": {
            "type": "string"
          },
          "gatewayNamespace": {
            "type": "string"
          },
          "gatewaySectionName": {
            "type": "string"
          }
        },
        "required": [
          "hostname"
        ]
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/persistence"
      }
    },
    "configMaps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ]
      }
    },
    "securityPreset": {
      "type": "string",
      "enum": [
        "default",
        "restricted",
        "root"
      ]
    },
    "podSecurityContext": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": [
            "string",
            "integer"
          ]
        },
        "path": {
          "type": "string"
        },
        "interval": {
          "type": "string"
        },
        "labels": {
          "type": "object"
        },
        "ruleInterval": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "alert": {
                "type": "string"
              },
              "record": {
                "type": "string"
              },
              "expr": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "for": {
                "type": "string"
              },
              "labels": {
                "type": "object"
              },
              "annotations": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "rules": {
          "type": "array"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array"
        },
        "egress": {
          "type": "array"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/databaseEntry"
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topologySpreadConstraint"
      }
    },
    "dnsConfig": {
      "type": "object"
    },
    "dnsPolicy": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "hostNetwork": {
      "type": "boolean"
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "labels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "completions": {
          "type": "integer",
          "minimum": 1
        },
        "parallelism": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cronJob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "timeZone": {
          "type": "string"
        },
        "concurrencyPolicy": {
          "type": "string",
          "enum": [
            "Allow",
            "Forbid",
            "Replace"
          ]
        },
        "startingDeadlineSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "suspend": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "image"
  ],
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository"
      ]
    },
    "containerPort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "containerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "hostPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "type": "string",
          "enum": [
            "TCP",
            "UDP",
            "SCTP"
          ]
        }
      },
      "required": [
        "containerPort"
      ]
    },
    "envValue": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretKeyRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "key"
              ]
            }
          },
          "required": [
            "secretKeyRef"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configMapKeyRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "key"
              ]
            }
          },
          "required": [
            "configMapKeyRef"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fieldRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fieldPath": {
                  "type": "string"
                }
              },
              "required": [
                "fieldPath"
              ]
            }
          },
          "required": [
            "fieldRef"
          ]
        }
      ]
    },
    "envMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/envValue"
      }
    },
    "envFromItem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "required": [
            "secretRef"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configMapRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "required": [
            "configMapRef"
          ]
        }
      ]
    },
    "envFromList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/envFromItem"
      }
    },
    "probeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "auto",
            "http",
            "tcp",
            "exec"
          ]
        },
        "path": {
          "type": "string"
        },
        "port": {
          "type": [
            "string",
            "integer"
          ]
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/containerPort"
          }
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "$ref": "#/$defs/envMap"
        },
        "envFrom": {
          "$ref": "#/$defs/envFromList"
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "liveness": {
              "oneOf": [
                {
                  "$ref": "#/$defs/probeConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "readiness": {
              "oneOf": [
                {
                  "$ref": "#/$defs/probeConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "startup": {
              "oneOf": [
                {
                  "$ref": "#/$defs/probeConfig"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "lifecycle": {
          "type": "object"
        },
        "volumeMounts": {
          "type": "array"
        }
      },
      "required": [
        "image"
      ]
    },
    "initContainer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "$ref": "#/$defs/envMap"
        },
        "envFrom": {
          "$ref": "#/$defs/envFromList"
        },
        "resources": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "volumeMounts": {
          "type": "array"
        }
      },
      "required": [
        "image"
      ]
    },
    "servicePort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "type": [
            "string",
            "integer"
          ]
        },
        "protocol": {
          "type": "string",
          "enum": [
            "TCP",
            "UDP",
            "SCTP"
          ]
        },
        "appProtocol": {
          "type": "string"
        },
        "nodePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "targetContainer": {
          "type": "string"
        },
        "port": {
          "type": [
            "integer",
            "null"
          ]
        },
        "targetPort": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "LoadBalancer",
            "NodePort"
          ]
        },
        "protocol": {
          "type": "string",
          "enum": [
            "TCP",
            "UDP",
            "SCTP"
          ]
        },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/servicePort"
          }
        },
        "annotations": {
          "type": "object"
        },
        "nodePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "loadBalancerIP": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "pvc",
            "volumeClaimTemplate",
            "emptyDir",
            "nfs",
            "configmap",
            "secret",
            "hostPath"
          ]
        },
        "mountPath": {
          "type": "string"
        },
        "subPath": {
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "size": {
          "type": "string"
        },
        "accessMode": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "existingClaim": {
          "type": "string"
        },
        "labels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        },
        "server": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "objectName": {
          "type": "string"
        },
        "items": {
          "type": "array"
        },
        "hostPath": {
          "type": "string"
        },
        "hostPathType": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "sizeLimit": {
          "type": "string"
        }
      },
      "required": [
        "mountPath"
      ]
    },
    "topologySpreadConstraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSkew": {
          "type": "integer"
        },
        "minDomains": {
          "type": "integer"
        },
        "topologyKey": {
          "type": "string"
        },
        "whenUnsatisfiable": {
          "type": "string",
          "enum": [
            "DoNotSchedule",
            "ScheduleAnyway"
          ]
        },
        "labelSelector": {
          "type": "object"
        },
        "matchLabelKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodeAffinityPolicy": {
          "type": "string",
          "enum": [
            "Honor",
            "Ignore"
          ]
        },
        "nodeTaintsPolicy": {
          "type": "string",
          "enum": [
            "Honor",
            "Ignore"
          ]
        }
      },
      "required": [
        "maxSkew",
        "topologyKey",
        "whenUnsatisfiable"
      ]
    },
    "databaseEntry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "cnpg",
            "crossplane",
            "external"
          ]
        },
        "database": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "walStorage": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "monitoring": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "backup": {
          "type": "object",
          "properties": {
            "schedule": {
              "type": "string"
            }
          },
          "required": [
            "schedule"
          ]
        },
        "pooler": {
          "type": "object",
